# Copy this file to ".env" (same folder) and fill in the values.
# .env is git-ignored. NEVER commit it or paste it anywhere public.

# ---- Required to publish ----
BINANCE_SQUARE_OPENAPI_KEY=

# ---- Local AI (Ollama) — runs on this PC, no key needed ----
# Install Ollama, then: ollama pull qwen2.5:3b
# 3B-4B models fit 8GB RAM without a GPU. Avoid "thinking" models (qwen3, deepseek-r1): too slow on CPU.
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Cloud AI fallbacks (optional but recommended; free tiers exist) ----
# Used if Ollama is down or its answer fails the fact check.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Order providers are tried in. Default on this PC when OLLAMA_MODEL is set:
# AI_PROVIDER_ORDER=ollama,groq,openrouter,gemini

# ---- Telegram one-tap approval (optional) ----
# Sensitive stories (hacks, thefts, bankruptcies, arrests, depegs, bans, deaths) get sent
# to your phone as [Post] / [Skip]; set NEWS_APPROVAL=all to approve every post.
# Nothing is published without your tap. Sensitive stories are held until a second
# outlet (or an official source) confirms them, with or without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# NEWS_APPROVAL=sensitive   # off | sensitive | all   (default: sensitive if Telegram is set up, else off)
# NEWS_APPROVAL_WAIT_MIN=8

# ---- News behaviour ----
# NEWS_POLL_SEC=150          # how often the PC checks for news (min 30)
# NEWS_MIN_SCORE=35          # importance bar; higher = fewer, bigger stories
# NEWS_MAX_PER_DAY=12
# NEWS_MIN_GAP_MIN=5         # minimum minutes between posts (0 = off)
# NEWS_MAX_AGE_HOURS=6
# NEWS_REQUIRE_AI=true       # skip a story rather than post the plain-headline fallback
# NEWS_EXTRA_FEEDS=Name|https://example.com/rss,Name2|https://other.com/feed

# ---- Git sync (the duplicate-post lock). Leave on. ----
# The runner turns this on automatically when this folder is a git clone.
# NEWS_GIT_SYNC=true
